#!/usr/bin/env python3
import sys
import random
import string
import subprocess

def main():
    args = sys.argv[1:]

    # ==========================================
    # MODE 1: DATA GENERATION
    # ==========================================
    if "-generate" in args:
        
        # We know test.sh passes the filename as the LAST argument in generate mode
        target_filename = args[-1] if not args[-1].startswith("-") else ""

        num_lines = random.randint(10, 50)
        alphabet = string.ascii_letters + string.digits + "()[]{}. \t"
        lines = [''.join(random.choice(alphabet) for _ in range(random.randint(5, 80))) for _ in range(num_lines)]
        lines.extend(["", "    \t   "]) 
        
        # 2. Pick a random substring for the pattern
        clean_line = random.choice(lines).replace(" ", "")
        
        # --- NEW: Strip dangerous regex metacharacters so we don't crash grep ---
        for char in "()[]{}.^$|\\":
            clean_line = clean_line.replace(char, "")

        if len(clean_line) > 5:
            start_idx = random.randint(0, len(clean_line) - 5)
            pattern = clean_line[start_idx:start_idx + random.randint(3, 8)]
        else:
            pattern = "a"

        # If the user passed -E to the generator, test regex
        if "-E" in args and random.random() < 0.6:
            chars = list(pattern)
            chars.insert(random.randint(0, len(chars)), random.choice(['*', '?', '+']))
            pattern = "".join(chars)

        args_string = f"'{pattern}' {target_filename}"

        print(args_string, file=sys.stderr)
        for line in lines:
            print(line)
            
        sys.exit(0)

    # ==========================================
    # MODE 2: GREP PASSTHROUGH
    # ==========================================
    try:
        base_command = ["grep"]
        # If the actual C program is being tested with color, let grep use color
        if not any(arg.startswith("--color") for arg in args):
            base_command.append("--color=never")

        result = subprocess.run(base_command + args)
        sys.exit(result.returncode)
    except Exception as e:
        print(f"Wrapper error running grep: {e}", file=sys.stderr)
        sys.exit(2)

if __name__ == "__main__":
    main()